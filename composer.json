{
    "name": "kikwik/command-blameable-bundle",
    "description": "Subscriber for gedmo/doctrine-extension Blameable that set the actual command name in the createdBy and updatedBy fields",
    "type": "symfony-bundle",
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Davide Scarpato",
            "email": "davide@kikwik.it"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/console": "^6.4|^7.0",
        "symfony/framework-bundle": "^6.4|^7.0",
        "stof/doctrine-extensions-bundle": "^1.7",
        "doctrine/orm": "3.*",
        "doctrine/doctrine-bundle": "2.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.1"
    },
    "autoload": {
        "psr-4": {
            "Kikwik\\CommandBlameableBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kikwik\\CommandBlameableBundle\\Tests\\": "tests/"
        }
    }
}
